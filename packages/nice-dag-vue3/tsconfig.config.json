{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "vite.config.*"
  ],
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  }
}
