{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue",
        "package.json"
    ],
    "compilerOptions": {
        "declaration": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@ebay/nice-dag-core/lib/types": [
                "../nice-dag-core/src/types.ts"
            ]
        },
        "types": [
            "vite/client"
        ],
        "noEmit": false,
        "isolatedModules": true
    },
}